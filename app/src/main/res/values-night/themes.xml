<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.PrayerNeeds" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->

        <item name="android:colorBackground">@color/backgroundColor</item>

<!--        <item name="backgroundTint">@color/backgroundColor</item>-->
        <item name="android:statusBarColor" tools:targetApi="l">@color/backgroundColor</item>
        <!-- Customize your theme here. -->
        <item name="android:actionBarStyle">@style/Widget.Theme.PrayerNeeds.ActionBar.FullScreen</item>
        <item name="actionBarWidgetTheme">@style/Widget.Theme.PrayerNeeds.ActionBar.FullScreen</item>
        <item name="actionBarTheme">@style/Widget.Theme.PrayerNeeds.ActionBar.FullScreen</item>
    </style>

    <style name="ThemeOverlay.PrayerNeeds.FullscreenContainer" parent="">
        <item name="fullscreenBackgroundColor">@color/light_blue_900</item>
        <item name="fullscreenTextColor">@color/light_blue_A400</item>
    </style>
</resources>