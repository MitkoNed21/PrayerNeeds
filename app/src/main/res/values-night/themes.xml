<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.PrayerNeeds" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
<!--        <item name="backgroundTint">@color/backgroundColor</item>-->
        <item name="android:statusBarColor" tools:targetApi="l">@color/backgroundColor_Night</item>
        <!-- Customize your theme here. -->

        <item name="android:colorBackground">@color/backgroundColor_Night</item>

        <item name="android:itemBackground">@color/dialog_nameContainerColor_Night</item>
        <item name="android:selectableItemBackgroundBorderless">
            @color/itemBackgroundColor_Night
        </item>
        <item name="editTextBackground">@color/editTextBackgroundColor_Night</item>
        <item name="android:popupBackground">@color/dialogBackground_Night</item>

        <item name="android:textColor">@color/dialog_nameContainerTextColor_Night</item>
        <item name="android:titleTextColor">@color/todayPrayerNeeds_personName_Night</item>

        <item name="android:actionBarStyle">@style/Widget.Theme.PrayerNeeds.ActionBar.FullScreen.Night</item>
        <item name="actionBarWidgetTheme">@style/Widget.Theme.PrayerNeeds.ActionBar.FullScreen.Night</item>
        <item name="actionBarTheme">@style/Widget.Theme.PrayerNeeds.ActionBar.FullScreen.Night</item>
    </style>

    <style name="ThemeOverlay.PrayerNeeds.FullscreenContainer" parent="">
        <item name="fullscreenBackgroundColor">@color/light_blue_900</item>
        <item name="fullscreenTextColor">@color/light_blue_A400</item>
    </style>

    <style name="Theme.PrayerNeeds.BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/shape_bottom_sheet_dialog</item>
        <item name="backgroundTint">@color/dialogBackground_Night</item>
    </style>
</resources>