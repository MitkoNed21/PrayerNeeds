<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_mainContainer"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/shape_rounded_corners_rectangle"
    android:backgroundTint="#20FFFFFF"
    android:backgroundTintMode="add"
    android:clickable="true">

    <TextView
        android:id="@+id/tv_personName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:text="TextView : Connected"
        android:textColor="#DFFFFFFF"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/shape_rounded_corners_rectangle"
        android:clipChildren="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/ibt_moreOptions"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/shape_rounded_corners_rectangle"
            android:clickable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:padding="0dp"
            android:scaleX="1.2"
            android:scaleY="1.2"
            android:src="@drawable/ic_more"
            app:barrierMargin="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_marginBaseline="0dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--    -->

</androidx.constraintlayout.widget.ConstraintLayout>