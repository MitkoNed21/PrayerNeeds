<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.PrayerNeedsActivity">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_prayerNeeds"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_addPrayerNeed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </androidx.recyclerview.widget.RecyclerView>

    <View
        android:id="@+id/divider2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="77dp"
        android:background="#242424"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="parent" />

    <EditText
        android:id="@+id/et_addPrayerNeed_prayerNeedText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="17dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/shape_rounded_rectangle"
        android:backgroundTint="#242424"
        android:inputType="textMultiLine|text|textCapSentences"
        android:lineHeight="20sp"
        android:minHeight="40sp"
        android:paddingVertical="5dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_addPrayerNeed"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- TODO: fix or use previous -->
    <ImageButton
        android:id="@+id/btn_addPrayerNeed"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="17dp"
        android:layout_marginBottom="11dp"
        android:background="@drawable/shape_rounded_rectangle"
        android:backgroundTint="@color/purple_500"
        android:foreground="@drawable/shape_name_container_options_button"
        android:padding="0dp"
        android:scaleX="1.0"
        android:scaleY="1.0"
        android:src="@drawable/ic_add"
        app:barrierMargin="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/et_addPrayerNeed_prayerNeedText"
        app:layout_constraintTop_toBottomOf="@+id/divider2"
        app:layout_marginBaseline="0dp" />

</androidx.constraintlayout.widget.ConstraintLayout>