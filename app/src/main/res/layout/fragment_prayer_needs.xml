<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.prayerneeds.PrayerNeedsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"><!--

        -->

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="3dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="3dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintBottom_toTopOf="@+id/btn_addPrayerNeed_fr"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_prayerNeeds_fr"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            </androidx.recyclerview.widget.RecyclerView>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <View
            android:id="@+id/divider2_fr"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="65dp"
            android:background="#242424"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="parent" />

        <EditText
            android:id="@+id/et_addPrayerNeed_prayerNeedText_fr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="17dp"
            android:layout_marginBottom="9dp"
            android:background="@drawable/shape_rounded_rectangle"
            android:backgroundTint="#242424"
            android:inputType="textMultiLine|text|textCapSentences"
            android:lineHeight="24sp"
            android:minHeight="48sp"
            android:paddingVertical="5dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_addPrayerNeed_fr"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- TODO: fix or use previous -->
        <ImageButton
            android:id="@+id/btn_addPrayerNeed_fr"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="11dp"
            android:layout_marginEnd="17dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/shape_rounded_rectangle"
            android:backgroundTint="@color/purple_500"
            android:foreground="@drawable/shape_name_container_options_button"
            android:padding="0dp"
            android:scaleX="1.0"
            android:scaleY="1.0"
            android:src="@drawable/ic_add"
            app:barrierMargin="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/et_addPrayerNeed_prayerNeedText_fr"
            app:layout_constraintTop_toBottomOf="@+id/divider2_fr"
            app:layout_marginBaseline="0dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>