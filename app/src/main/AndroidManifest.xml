<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mitkoned.prayerneeds">

    <application
        android:allowBackup="true"
        android:fullBackupOnly="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PrayerNeeds">
        <activity
            android:name=".activities.ViewTodaysPrayerNeedsFullscreenActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:label="@string/title_activity_view_todays_prayer_needs_fullscreen"
            android:screenOrientation="sensorPortrait"
            android:theme="@style/Theme.PrayerNeeds.Fullscreen" />
        <activity
            android:name=".activities.PrayerNeedsActivity"
            android:screenOrientation="sensorPortrait" />
        <activity
            android:name=".activities.PeopleTodayActivity"
            android:screenOrientation="sensorPortrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activities.AllPeopleActivity"
            android:screenOrientation="sensorPortrait" />
    </application>

</manifest>